{
  "name": "ai-dev-orchestrator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:typecheck": "npm run typecheck --prefix frontend",
    "api:dev": "dotnet run --project backend/services/Assimalign.AI.Orchestrator.Api/Assimalign.AI.Orchestrator.Api.csproj",
    "worker:dev": "dotnet run --project backend/services/Assimalign.AI.Orchestrator.Worker/Assimalign.AI.Orchestrator.Worker.csproj",
    "build": "dotnet build Assimalign.AI.Orchestrator.slnx && npm run build --prefix frontend",
    "check": "dotnet build Assimalign.AI.Orchestrator.slnx && npm run typecheck --prefix frontend"
  }
}
